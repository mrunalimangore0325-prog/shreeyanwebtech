@{
    ViewData["Title"] = "About";
}

<section class="section page-hero">
    <div class="container">
        <p class="eyebrow">Who we are</p>
        <h1 class="section-title">Trusted solutions, built for high-profile and high-stakes projects.</h1>
        <p class="section-lead">
            Shreeyan Webtech designs and develops websites, web applications, and special purpose
            software for businesses that need more than a template. We work directly with the
            people who understand the business — no account managers relaying messages, no scope
            creep, no surprises at launch.
        </p>
    </div>
</section>

<section class="section pt-0">
    <div class="container">
        <div class="stats-band" data-reveal>
            <div class="stats-band__grid">
                <div class="stat-item">
                    <span class="stat-number"><span data-count-to="117">0</span><span class="stat-number__suffix">+</span></span>
                    <p class="stat-label">High-profile &amp; security projects delivered</p>
                </div>
                <div class="stat-item">
                    <span class="stat-number"><span data-count-to="21">0</span><span class="stat-number__suffix">+</span></span>
                    <p class="stat-label">International clients served</p>
                </div>
                <div class="stat-item">
                    <span class="stat-number"><span data-count-to="147">0</span><span class="stat-number__suffix">+</span></span>
                    <p class="stat-label">Total clients across all group companies</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="split" data-reveal>
            <div>
                <p class="eyebrow">Our approach</p>
                <h2 class="split-statement">Technology With <span class="text-accent">Purpose.</span></h2>
            </div>
            <div>
                <p class="section-lead" style="max-width:none;">
                    A website only matters if it does something for the business behind it. So every
                    project starts with the same question: what does this business actually need to
                    happen next? The design and the code follow from that answer.
                </p>
                <div class="split-points">
                    <div class="split-point">
                        <span class="split-point__icon"><partial name="_Icon" model="@("compass")" /></span>
                        <p><strong>Understanding requirements</strong> before a single screen gets designed.</p>
                    </div>
                    <div class="split-point">
                        <span class="split-point__icon"><partial name="_Icon" model="@("layout")" /></span>
                        <p><strong>User-focused design</strong> that's built around how people will actually use it.</p>
                    </div>
                    <div class="split-point">
                        <span class="split-point__icon"><partial name="_Icon" model="@("code")" /></span>
                        <p><strong>Modern development</strong>, built for scale from day one.</p>
                    </div>
                    <div class="split-point">
                        <span class="split-point__icon"><partial name="_Icon" model="@("wrench")" /></span>
                        <p><strong>Long-term support</strong> — launch day is the start of the relationship, not the end.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section--alt">
    <div class="container">
        <div class="section-head section-head--center" data-reveal>
            <p class="eyebrow" style="justify-content:center;">What sets us apart</p>
            <h2 class="section-title">We don't do general solutions. We do extraordinary ones.</h2>
            <p class="section-lead">
                Every engagement is fully customised to what the client actually needs — built with
                high performance in mind, and backed by fast support after deployment.
            </p>
        </div>
        <div class="row g-4" data-reveal>
            <div class="col-md-6 col-lg-4">
                <div class="value-card">
                    <div class="card-icon"><partial name="_Icon" model="@("award")" /></div>
                    <h3 class="value-card__title">High-profile project experience</h3>
                    <p class="value-card__desc">We provide trusted solutions with a track record on high-profile, high-stakes projects.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="value-card">
                    <div class="card-icon"><partial name="_Icon" model="@("spark")" /></div>
                    <h3 class="value-card__title">Special purpose software</h3>
                    <p class="value-card__desc">We specialise in special purpose software and application development, not just generic websites.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="value-card">
                    <div class="card-icon"><partial name="_Icon" model="@("lock")" /></div>
                    <h3 class="value-card__title">Dedicated cyber security team</h3>
                    <p class="value-card__desc">A dedicated team handles cyber security solutions and services across everything we deliver.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="value-card">
                    <div class="card-icon"><partial name="_Icon" model="@("building")" /></div>
                    <h3 class="value-card__title">Cross-industry expertise</h3>
                    <p class="value-card__desc">We work with industrial companies, hospitality, schools and universities, startups, and software automation businesses.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="value-card">
                    <div class="card-icon"><partial name="_Icon" model="@("target")" /></div>
                    <h3 class="value-card__title">Fully customised builds</h3>
                    <p class="value-card__desc">No off-the-shelf packages — every solution is fully customised around what the customer needs, with high performance.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="value-card">
                    <div class="card-icon"><partial name="_Icon" model="@("wrench")" /></div>
                    <h3 class="value-card__title">Fast post-deployment support</h3>
                    <p class="value-card__desc">Our service after deployment is fast — we stay reachable for updates, fixes, and ongoing improvements.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- NEW: Mission & Vision -->
<section class="section">
    <div class="container">
        <div class="row g-4" data-reveal>
            <div class="col-md-6">
                <div class="mv-card">
                    <div class="card-icon"><partial name="_Icon" model="@("compass")" /></div>
                    <h3 class="mv-card__title">Our Mission</h3>
                    <p class="mv-card__desc">
                        To give businesses technology that actually fits how they work — websites,
                        software, and security built around real requirements, delivered by people who
                        stay accountable after launch.
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mv-card mv-card--alt">
                    <div class="card-icon"><partial name="_Icon" model="@("rocket")" /></div>
                    <h3 class="mv-card__title">Our Vision</h3>
                    <p class="mv-card__desc">
                        To grow into a group of specialised businesses trusted with the kind of
                        high-stakes, high-profile projects that require precision, security, and people
                        who don't cut corners.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- NEW: Industries we serve -->
<section class="section section--alt">
    <div class="container">
        <div class="section-head section-head--center" data-reveal>
            <p class="eyebrow" style="justify-content:center;">Who we work with</p>
            <h2 class="section-title">Industries we serve.</h2>
            <p class="section-lead">
                Our work spans well beyond typical web agencies — a byproduct of being part of a
                group that already operates across industrial, energy, and enterprise sectors.
            </p>
        </div>
        <div class="row g-3" data-reveal>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="industry-chip"><partial name="_Icon" model="@("building")" /><span>Industrial &amp; Manufacturing</span></div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="industry-chip"><partial name="_Icon" model="@("layers")" /><span>Hospitality</span></div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="industry-chip"><partial name="_Icon" model="@("building")" /><span>Hotels</span></div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="industry-chip"><partial name="_Icon" model="@("award")" /><span>Schools &amp; Universities</span></div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="industry-chip"><partial name="_Icon" model="@("rocket")" /><span>Startups</span></div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="industry-chip"><partial name="_Icon" model="@("spark")" /><span>Energy &amp; Automation</span></div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="industry-chip"><partial name="_Icon" model="@("lock")" /><span>Security-focused Clients</span></div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head section-head--center" data-reveal>
            <p class="eyebrow" style="justify-content:center;">What we value</p>
            <h2 class="section-title">Built Around Your Business.</h2>
        </div>
        <div class="row g-4" data-reveal>
            <div class="col-md-4">
                <div class="value-card">
                    <div class="card-icon"><partial name="_Icon" model="@("chat")" /></div>
                    <h3 class="value-card__title">Direct access</h3>
                    <p class="value-card__desc">You talk to the person building your project, not a relay chain.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <div class="card-icon"><partial name="_Icon" model="@("target")" /></div>
                    <h3 class="value-card__title">Honest scoping</h3>
                    <p class="value-card__desc">We tell you what a project actually needs — nothing padded, nothing missing.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <div class="card-icon"><partial name="_Icon" model="@("shield")" /></div>
                    <h3 class="value-card__title">Support that continues</h3>
                    <p class="value-card__desc">We stay reachable after launch for updates, fixes, and questions.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head section-head--center" data-reveal>
            <p class="eyebrow" style="justify-content:center;">The client experience</p>
            <h2 class="section-title">A process with no surprises.</h2>
        </div>
        <div class="flow" data-reveal>
            <span class="flow-node">Requirement</span>
            <span class="flow-arrow"><partial name="_Icon" model="@("arrow")" /></span>
            <span class="flow-node">Strategy</span>
            <span class="flow-arrow"><partial name="_Icon" model="@("arrow")" /></span>
            <span class="flow-node">Design</span>
            <span class="flow-arrow"><partial name="_Icon" model="@("arrow")" /></span>
            <span class="flow-node">Development</span>
            <span class="flow-arrow"><partial name="_Icon" model="@("arrow")" /></span>
            <span class="flow-node">Testing</span>
            <span class="flow-arrow"><partial name="_Icon" model="@("arrow")" /></span>
            <span class="flow-node">Launch</span>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head section-head--center" data-reveal>
            <p class="eyebrow" style="justify-content:center;">Client feedback</p>
            <h2 class="section-title">What clients say</h2>
        </div>
        <div class="testimonial-placeholder" data-reveal>
            <span class="testimonial-placeholder__icon"><partial name="_Icon" model="@("chat")" /></span>
            <h3 class="testimonial-placeholder__title">Testimonials coming soon</h3>
            <p class="testimonial-placeholder__desc">This space is reserved for real feedback from clients we've worked with — added as projects launch.</p>
        </div>
    </div>
</section>

<section class="section section--alt">
    <div class="container final-cta" data-reveal>
        <p class="eyebrow" style="justify-content:center;">Let's talk</p>
        <h2 class="section-title">Have a project in mind?</h2>
        <p class="cta-banner__text" style="color: var(--muted);">We'll reply with a straight answer, usually within one business day.</p>
        <div class="hero-actions">
            <a class="btn btn-primary btn-lg" asp-controller="Home" asp-action="Contact">Get in touch</a>
        </div>
    </div>
</section>
