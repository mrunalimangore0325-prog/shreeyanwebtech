@model List<ServiceItem>
@{
    ViewData["Title"] = "Website & Web Application Development";
}

<section class="hero hero--video">
    <div class="hero-bg" aria-hidden="true">
        <video class="hero-bg__video" id="heroBgVideo" autoplay muted loop playsinline preload="auto">
            <source src="/videos/ShreeYaan_Vid.mp4" type="video/mp4">
        </video>
        <div class="hero-bg__overlay"></div>
    </div>
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <p class="eyebrow">Website, web application development &amp; End-to-end software solutions for your business </p>
                <h1 class="hero-title" data-split-words>We Build Digital Experiences That Move Businesses Forward.</h1>
                <p class="hero-lead">
                    We design and develop modern websites and web applications that help businesses
                    establish their digital presence, connect with customers, and grow.
                </p>
                <div class="hero-ticker" aria-live="polite">
                    <span class="hero-ticker__dot" aria-hidden="true"></span>
                    <span class="hero-ticker__rail">
                        <span class="hero-ticker__item">Custom web applications </span>
                        <span class="hero-ticker__item">Dedicated cyber security &amp; monitoring</span>
                        <span class="hero-ticker__item">Business websites scoped to your needs</span>
                    </span>
                </div>
                <div class="hero-actions">
                    <a class="btn btn-primary btn-lg" asp-controller="Home" asp-action="Contact">
                        Start Your Project
                        <partial name="_Icon" model="@("arrow")" />
                    </a>
                    <a class="btn btn-ghost btn-lg" asp-controller="Home" asp-action="Portfolio">Explore Our Work</a>
                </div>
                <div class="hero-trust">
                    <span class="hero-trust__item"><partial name="_Icon" model="@("check")" />Modern UI/UX</span>
                    <span class="hero-trust__item"><partial name="_Icon" model="@("check")" />Responsive builds</span>
                  
                </div>
            </div>
            <div class="col-lg-6">
                <div class="code-stack" aria-hidden="true">
                    <div class="code-window">
                        <div class="code-window__bar">
                            <span class="code-window__dot code-window__dot--red"></span>
                            <span class="code-window__dot code-window__dot--amber"></span>
                            <span class="code-window__dot code-window__dot--green"></span>
                            <span class="code-window__file">Index.cshtml</span>
                        </div>
                        <div class="code-window__body">
                            <div class="code-line"><span class="code-ln">1</span><span class="code-tok code-tok--tag">&lt;section</span> <span class="code-tok code-tok--attr">class</span>=<span class="code-tok code-tok--str">"hero"</span><span class="code-tok code-tok--tag">&gt;</span></div>
                            <div class="code-line"><span class="code-ln">2</span><span class="code-tok code-tok--indent"></span><span class="code-tok code-tok--tag">&lt;h1&gt;</span><span class="code-tok code-tok--plain">We Build Digital</span></div>
                            <div class="code-line"><span class="code-ln">3</span><span class="code-tok code-tok--kw">public class</span> <span class="code-tok code-tok--fn">HomeController</span></div>
                            <div class="code-line"><span class="code-ln">4</span><span class="code-tok code-tok--indent"></span><span class="code-tok code-tok--kw">return</span> <span class="code-tok code-tok--fn">View</span><span class="code-tok code-tok--plain">(model);</span></div>
                            <div class="code-line"><span class="code-ln">5</span><span class="code-tok code-tok--indent"></span><span class="code-tok code-tok--cmt">// build. ship. scale.</span><span class="code-cursor"></span></div>
                        </div>
                    </div>

                    <span class="lang-chip lang-chip--csharp">C#</span>
                    <span class="lang-chip lang-chip--dotnet">.NET</span>
                    <span class="lang-chip lang-chip--js">JavaScript</span>
                    <span class="lang-chip lang-chip--sql">SQL</span>
                    <span class="lang-chip lang-chip--html">HTML5</span>
                    <span class="lang-chip lang-chip--react">React</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="trust-strip">
    <div class="container">
        <div class="trust-strip__row">
            <span class="trust-item"><partial name="_Icon" model="@("layout")" />Modern UI/UX</span>
            <span class="trust-item"><partial name="_Icon" model="@("grid")" />Responsive Development</span>
            <span class="trust-item"><partial name="_Icon" model="@("layers")" />Scalable Solutions</span>
            <span class="trust-item"><partial name="_Icon" model="@("target")" />Business-Focused Approach</span>
        </div>
    </div>
</section>

<section class="section pb-0">
    <div class="container">
        <div class="stats-band" data-reveal>
            <div class="stats-band__grid">
                <div class="stat-item">
                    <span class="stat-number"><span data-count-to="117">0</span><span class="stat-number__suffix">+</span></span>
                    <p class="stat-label">High-profile &amp; security projects delivered</p>
                </div>
                <div class="stat-item">
                    <span class="stat-number"><span data-count-to="21">0</span><span class="stat-number__suffix">+</span></span>
                    <p class="stat-label">International clients served</p>
                </div>
                <div class="stat-item">
                    <span class="stat-number"><span data-count-to="147">0</span><span class="stat-number__suffix">+</span></span>
                    <p class="stat-label">Total clients across all group companies</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="split" data-reveal>
            <div>
                <p class="eyebrow">Who we are</p>
                <h2 class="split-statement">Technology With <span class="text-accent">Purpose.</span></h2>
            </div>
            <div>
                <p class="section-lead" style="max-width:none;">
                    We provide trusted solutions with high-profile projects, specialising in special
                    purpose software and application development — with a dedicated team for cyber
                    security solutions and services.
                </p>
                <div class="split-points">
                    <div class="split-point">
                        <span class="split-point__icon"><partial name="_Icon" model="@("compass")" /></span>
                        <p><strong>Requirement-first:</strong> we scope around your business, not a generic package.</p>
                    </div>
                    <div class="split-point">
                        <span class="split-point__icon"><partial name="_Icon" model="@("lock")" /></span>
                        <p><strong>Cyber security focused:</strong> a dedicated team protecting what we build.</p>
                    </div>
                    <div class="split-point">
                        <span class="split-point__icon"><partial name="_Icon" model="@("shield")" /></span>
                        <p><strong>Reliable technology:</strong> for stability and long-term support.</p>
                    </div>
                </div>
                <a class="link-arrow mt-4 d-inline-flex" asp-controller="Home" asp-action="About">
                    More about how we work <partial name="_Icon" model="@("arrow")" />
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section section--alt">
    <div class="container">
        <div class="section-head section-head--center" data-reveal>
            <p class="eyebrow" style="justify-content:center;">What we do</p>
            <h2 class="section-title">Services scoped to your business.</h2>
            <p class="section-lead">From a single business website to a full custom web application — every engagement starts with your requirements, not a fixed package.</p>
        </div>
        <div class="row g-4">
            @foreach (var service in Model)
            {
                <div class="col-md-6 col-lg-4" data-reveal>
                    <div class="service-card">
                        <div class="card-icon"><partial name="_Icon" model="@service.IconKey" /></div>
                        <h3 class="service-card__title">@service.Title</h3>
                        <p class="service-card__desc">@service.Description</p>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-5">
            <a class="link-arrow" asp-controller="Home" asp-action="Services">See all services <partial name="_Icon" model="@("arrow")" /></a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head section-head--center" data-reveal>
            <p class="eyebrow" style="justify-content:center;">How we work</p>
            <h2 class="section-title">From Idea to Digital Product.</h2>
        </div>
        <div class="process-rail" data-reveal>
            <div class="process-step">
                <span class="process-step__num">01</span>
                <h3 class="process-step__title">Discover</h3>
                <p class="process-step__desc">Understand requirements and business goals.</p>
            </div>
            <div class="process-step">
                <span class="process-step__num">02</span>
                <h3 class="process-step__title">Plan</h3>
                <p class="process-step__desc">Define structure, features, and user experience.</p>
            </div>
            <div class="process-step">
                <span class="process-step__num">03</span>
                <h3 class="process-step__title">Design</h3>
                <p class="process-step__desc">Create the visual interface and user journey.</p>
            </div>
            <div class="process-step">
                <span class="process-step__num">04</span>
                <h3 class="process-step__title">Develop</h3>
                <p class="process-step__desc">Build using modern, reliable technology.</p>
            </div>
            <div class="process-step">
                <span class="process-step__num">05</span>
                <h3 class="process-step__title">Launch</h3>
                <p class="process-step__desc">Deploy, test, and provide ongoing support.</p>
            </div>
        </div>
        <div class="text-center mt-5">
            <a class="link-arrow" asp-controller="Home" asp-action="Process">See our full process <partial name="_Icon" model="@("arrow")" /></a>
        </div>
    </div>
</section>

<section class="section section--alt">
    <div class="container">
        <div class="section-head section-head--center" data-reveal>
            <p class="eyebrow" style="justify-content:center;">Built around your business</p>
            <h2 class="section-title">Why teams choose to work with us.</h2>
        </div>
        <div class="reason-grid" data-reveal>
            <div class="reason">
                <span class="reason__icon"><partial name="_Icon" model="@("target")" /></span>
                <div>
                    <h3 class="reason__title">Business-focused development</h3>
                    <p class="reason__desc">Every decision is scoped around what your business actually needs.</p>
                </div>
            </div>
            <div class="reason">
                <span class="reason__icon"><partial name="_Icon" model="@("layout")" /></span>
                <div>
                    <h3 class="reason__title">Modern UI/UX</h3>
                    <p class="reason__desc">Clean, intentional interfaces designed around real user behaviour.</p>
                </div>
            </div>
            <div class="reason">
                <span class="reason__icon"><partial name="_Icon" model="@("grid")" /></span>
                <div>
                    <h3 class="reason__title">Responsive by default</h3>
                    <p class="reason__desc">Every build is tested across desktop, tablet, and mobile.</p>
                </div>
            </div>
            <div class="reason">
                <span class="reason__icon"><partial name="_Icon" model="@("layers")" /></span>
                <div>
                    <h3 class="reason__title">Scalable architecture</h3>
                    <p class="reason__desc">Built to grow with your business, not to be rebuilt in a year.</p>
                </div>
            </div>
            <div class="reason">
                <span class="reason__icon"><partial name="_Icon" model="@("chat")" /></span>
                <div>
                    <h3 class="reason__title">Clear communication</h3>
                    <p class="reason__desc">You always know what's happening and what comes next.</p>
                </div>
            </div>
            <div class="reason">
                <span class="reason__icon"><partial name="_Icon" model="@("wrench")" /></span>
                <div>
                    <h3 class="reason__title">Ongoing support</h3>
                    <p class="reason__desc">We stay reachable after launch for updates and fixes.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="cta-banner" data-reveal>
            <div class="cta-banner__content">
                <p class="eyebrow eyebrow--dark">Next step</p>
                <h2 class="cta-banner__title">Have a Project in Mind?</h2>
                <p class="cta-banner__text">Let's turn your idea into a modern digital experience.</p>
            </div>
            <div class="cta-banner__actions">
                <a class="btn btn-primary btn-lg" asp-controller="Home" asp-action="Contact">Start Your Project</a>
                <a class="btn btn-ghost btn-ghost--onDark btn-lg" asp-controller="Home" asp-action="Contact">Talk to Our Team</a>
            </div>
        </div>
    </div>
</section>